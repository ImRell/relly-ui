{
  "name": "relly-ui",
  "version": "1.1.1",
  "description": "High-performance, elegant, and extensible GUI control panel library with CDN support and Fluent API",
  "main": "./dist/relly-ui.umd.js",
  "module": "./dist/relly-ui.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/relly-ui.iife.js",
  "jsdelivr": "./dist/relly-ui.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/relly-ui.es.js",
      "require": "./dist/relly-ui.umd.js"
    },
    "./style.css": "./dist/relly-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.config.ts && vite build --config vite.cdn.config.ts",
    "preview": "vite preview",
    "pretest": "vite build --config vite.cdn.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css,json}\""
  },
  "keywords": [
    "gui",
    "control-panel",
    "dat-gui",
    "tweakpane",
    "debug",
    "ui",
    "canvas",
    "webgl",
    "cdn"
  ],
  "author": "Rell",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "happy-dom": "^17.1.8",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5"
  }
}
